# Terraform working directory and state (state can contain secrets: never commit it)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfstate.d/
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfplan

# Local variable files (copy terraform.tfvars.example instead)
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS / editor
.DS_Store
.idea/
.vscode/
